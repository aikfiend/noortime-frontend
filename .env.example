# Copy to .env.local and fill in real values. Never commit .env.local.

# MySQL connection string
DATABASE_URL=mysql://user:password@localhost:3306/noortime

# Google OAuth credentials (console.cloud.google.com)
# Authorized redirect URI must include: https://your-domain/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# NextAuth secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# Public URL of this app (used by NextAuth for callbacks)
NEXTAUTH_URL=http://localhost:5173

# Restrict sign-in to a single email domain (without the @)
ALLOWED_EMAIL_DOMAIN=clips4sale.com
